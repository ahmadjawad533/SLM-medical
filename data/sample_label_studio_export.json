            "type": "textarea",
            "value": { "text": ["Patient was bitten by a dark snake on foot and feels eyelids drooping."] }
          },
          {
            "from_name": "clarifying_questions",
            "to_name": "text",
            "type": "textarea",
            "value": { "text": ["Are they having difficulty swallowing or breathing? Is the limb swelling rapidly?"] }
          },
          {
            "from_name": "clinician_response",
            "to_name": "text",
            "type": "textarea",
            "value": { "text": ["CRITICAL NEUROTOXIC SNAKEBITE: 1. Keep completely still. 2. Splint the bitten leg. 3. Transport immediately to antivenom center."] }
          },
          {
            "from_name": "approval_status",
            "to_name": "choice",
            "type": "choices",
            "value": { "choices": ["CLINICALLY_APPROVED"] }
