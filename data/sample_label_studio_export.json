            "value": { "text": ["Worker collapsed in hot field, skin hot and dry, confused."] }
          },
          {
            "from_name": "clarifying_questions",
            "to_name": "text",
            "type": "textarea",
            "value": { "text": ["Are they sweating? Can they drink water?"] }
          },
