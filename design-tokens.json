      "syncing": {
        "badgeBg": { "value": "#1E40AF", "type": "color" },
        "badgeText": { "value": "#BFDBFE", "type": "color" },
        "label": { "value": "Online • Syncing Data", "type": "string" }
      }
    }
  },
  "touchTarget": {
    "minStandard": { "value": "56px", "type": "dimension" },
    "primaryAction": { "value": "64px", "type": "dimension" },
    "emergencySOS": { "value": "84px", "type": "dimension" },
    "voiceMicButton": { "value": "76px", "type": "dimension" }
