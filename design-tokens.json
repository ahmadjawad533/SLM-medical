        "sm": { "value": "16px" },
        "base": { "value": "18px" },
        "lg": { "value": "22px" },
        "xl": { "value": "28px" },
        "2xl": { "value": "36px" }
      },
      "largeFontMode": {
        "xs": { "value": "16px" },
        "sm": { "value": "20px" },
        "base": { "value": "24px" },
        "lg": { "value": "28px" },
        "xl": { "value": "36px" },
        "2xl": { "value": "44px" }
      }
    },
    "fontWeight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" },
      "heavy": { "value": "900" }
    }
  },
  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "2xl": { "value": "48px" }
  },
  "radii": {
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "full": { "value": "9999px" }
  }
}
